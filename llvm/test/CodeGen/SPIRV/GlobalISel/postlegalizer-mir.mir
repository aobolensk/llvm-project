# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -O0 -mtriple=spirv64-unknown-unknown -verify-machineinstrs -run-pass=spirv-postlegalizer %s -o - | FileCheck %s

# Reuses the restored types %2 and %4 instead of declaring new ones.

--- |
  define i1 @f(i32 %a, i32 %b) {
    ret i1 false
  }
...
---
name:            f
legalized:       true
tracksRegLiveness: true
machineFunctionInfo:
  vregTypes:
    - { reg: '%0', type: '%2' }
    - { reg: '%1', type: '%2' }
    - { reg: '%7', type: '%4' }
  lastInsertedType: '%5'
body:             |
  bb.1 (%ir-block.0):
    ; CHECK-LABEL: name: f
    ; CHECK: [[OpTypeInt:%[0-9]+]]:type(s64) = OpTypeInt 32, 0
    ; CHECK-NEXT: [[OpTypeBool:%[0-9]+]]:type(s64) = OpTypeBool
    ; CHECK-NEXT: [[OpTypeFunction:%[0-9]+]]:type(s64) = OpTypeFunction [[OpTypeBool]](s64), [[OpTypeInt]](s64), [[OpTypeInt]](s64)
    ; CHECK-NEXT: [[OpFunction:%[0-9]+]]:iid(s64) = OpFunction [[OpTypeBool]](s64), 0, [[OpTypeFunction]](s64)
    ; CHECK-NEXT: [[OpFunctionParameter:%[0-9]+]]:iid(s32) = OpFunctionParameter [[OpTypeInt]](s64)
    ; CHECK-NEXT: [[OpFunctionParameter1:%[0-9]+]]:iid(s32) = OpFunctionParameter [[OpTypeInt]](s64)
    ; CHECK-NEXT: [[ADD:%[0-9]+]]:iid(s32) = G_ADD [[OpFunctionParameter]], [[OpFunctionParameter1]]
    ; CHECK-NEXT: [[ASSIGN_TYPE:%[0-9]+]]:iid(s32) = ASSIGN_TYPE [[ADD]](s32), [[OpTypeInt]](s64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:iid(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[ASSIGN_TYPE1:%[0-9]+]]:iid(s32) = ASSIGN_TYPE [[C]](s32), [[OpTypeInt]](s64)
    ; CHECK-NEXT: [[ICMP:%[0-9]+]]:iid(s1) = G_ICMP intpred(slt), [[ASSIGN_TYPE]](s32), [[OpFunctionParameter]]
    ; CHECK-NEXT: [[ICMP1:%[0-9]+]]:iid(s1) = G_ICMP intpred(slt), [[OpFunctionParameter1]](s32), [[ASSIGN_TYPE1]]
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:iid(s1) = G_XOR [[ICMP1]], [[ICMP]]
    ; CHECK-NEXT: [[ASSIGN_TYPE2:%[0-9]+]]:iid(s1) = ASSIGN_TYPE [[XOR]](s1), [[OpTypeBool]](s64)
    ; CHECK-NEXT: OpReturnValue [[ASSIGN_TYPE2]](s1)
    %2:type(s64) = OpTypeInt 32, 0
    %4:type(s64) = OpTypeBool
    %5:type(s64) = OpTypeFunction %4(s64), %2(s64), %2(s64)
    %3:iid(s64) = OpFunction %4(s64), 0, %5(s64)
    %0:iid(s32) = OpFunctionParameter %2(s64)
    %1:iid(s32) = OpFunctionParameter %2(s64)
    %8:_(s32) = G_ADD %0, %1
    %9:_(s32) = G_CONSTANT i32 0
    %10:_(s1) = G_ICMP intpred(slt), %8(s32), %0
    %11:_(s1) = G_ICMP intpred(slt), %1(s32), %9
    %7:id(s1) = G_XOR %11, %10
    OpReturnValue %7(s1)
...
